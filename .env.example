# =============================================================================
# AgentShield-X Production Environment Configuration Template
# Copy this file to .env and configure secrets before deployment.
# =============================================================================

# 1. AI Engine & ShieldWing Provider (NVIDIA NIM)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
SHIELDWING_PROVIDER=nvidia

# 2. Supabase Production PostgreSQL Database & Project Configuration
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_DB_HOST=db.[PROJECT_REF].supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_db_password
SUPABASE_PROJECT_REF=your_supabase_project_ref

# 3. Supabase Client Configuration (Vite Console & Web Clients)
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 4. Firebase Production Configuration (Google OAuth & Identity)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=agentshield-x.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=agentshield-x
VITE_FIREBASE_STORAGE_BUCKET=agentshield-x.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=688888988426
VITE_FIREBASE_APP_ID=1:688888988426:web:a4a15cc491bbd51a8470f3
VITE_FIREBASE_MEASUREMENT_ID=G-7MPVTTR01Y

# 5. Zero-Trust Security, Attestation & CORS Gatekeeper
SHIELD_ATTESTATION_SECRET=generate_strong_64_char_hex_secret_here
JWT_SECRET=generate_strong_256_bit_jwt_secret_here
SHIELD_POLICY=strict
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://agentshield.ai
RATE_LIMIT_STANDARD_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=15
SPEND_CAP_MONTHLY=250.00
DEBUG=False
LOG_LEVEL=info
