# AgentShield-X Environment Configuration

# Shieldwing SOC AI Copilot Configuration (NVIDIA NIM)
# Get your free key at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
SHIELDWING_PROVIDER=nvidia

# Gateway and Control API Ports & Secrets
PORT=8000
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
JWT_SECRET=super-secret-jwt-key-for-development
SHIELD_JWT_SECRET=super-secret-jwt-key-for-development
SHIELD_ATTESTATION_SECRET=super-secret-attestation-hmac-key
SHIELD_CANARY_SECRET=super-secret-honeytoken-canary-key

# Supabase Production PostgreSQL Database
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-password
SUPABASE_PROJECT_REF=your-project-ref
