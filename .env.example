# =============================================================================
# AgentShield-X Production Environment Configuration Template
# Copy this file to .env and configure secrets before production deployment
# DO NOT COMMIT .env TO VERSION CONTROL
# =============================================================================

# 1. Zero-Trust Attestation & Cryptographic Integrity
SHIELD_ATTESTATION_SECRET=generate_strong_64_char_hex_secret_here
JWT_SECRET=generate_strong_256_bit_jwt_secret_here
SHIELD_POLICY=strict

# 2. Network & CORS Gatekeeper (Comma-separated allowed origins, NO wildcards in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://agentshield.ai

# 3. Rate Limiting (Token Bucket / Sliding Window)
RATE_LIMIT_STANDARD_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=15

# 4. Financial Spend Cap & LLM Proxy Armor
SPEND_CAP_MONTHLY=250.00
LLM_PROVIDER_MAX_TOKENS_PER_CALL=4096

# 5. Production Diagnostics & Error Sanitization
DEBUG=False
LOG_LEVEL=info

# 6. Firebase Authentication (Google OAuth) Client Keys
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=agentshield-x.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=agentshield-x
VITE_FIREBASE_STORAGE_BUCKET=agentshield-x.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1029384756
VITE_FIREBASE_APP_ID=1:1029384756:web:89abcdef012345
