# ==============================================================================
# AgentShield-X Voice Blueprint Configuration (NVIDIA Nemotron + Magpie TTS)
# ==============================================================================

# NVIDIA NGC / API Credentials (obtain from https://build.nvidia.com)
NGC_API_KEY=nvapi-your-nvidia-ngc-api-key-here
NVAPI_KEY=nvapi-your-nvidia-ngc-api-key-here

# Pipeline Architecture: 'cascaded' (ASR -> LLM -> TTS) or 'omni' (Nemotron-3 Omni)
NEMOTRON_VOICE_PIPELINE=cascaded

# Recommended Model Roster
NEMOTRON_ASR_MODEL=nvidia/nemotron-speech-streaming-0.6b
NEMOTRON_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_TTS_MODEL=nvidia/magpie-tts-multilingual

# Endpoint URLs (NVIDIA NIM or Cloud build.nvidia.com endpoints)
NIM_ASR_URL=http://localhost:8000
NIM_LLM_URL=http://localhost:8001/v1
NIM_TTS_URL=http://localhost:8003

# Interruption Management & Turn-Taking (Pipecat + Silero VAD)
SILERO_VAD_THRESHOLD=0.5
PIPECAT_TURN_TIMEOUT_SEC=1.0
VOICE_BARGE_IN_ENABLED=true

# Supported Default Locale (en-US, es-ES, de-DE, fr-FR, it-IT, pt-BR, zh-CN, ja-JP, ko-KR, hi-IN, nl-NL, pl-PL)
DEFAULT_VOICE_LANGUAGE=en-US

# AgentShield Security Policy
AGENTSHIELD_MODE=enforce
GUARDRAIL_DETERMINISTIC_LATENCY_MAX_MS=0.85

